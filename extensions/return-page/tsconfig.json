{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  }
}